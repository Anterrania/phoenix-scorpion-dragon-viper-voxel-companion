 	flying = on
 	velocity.y = 2.0 if on else velocity.y
 	flying_changed.emit(on)
@@ -171,6 +175,9 @@ func _fly_step(delta: float, dir: Vector3) -> void:
 
 func _physics_process(delta: float) -> void:

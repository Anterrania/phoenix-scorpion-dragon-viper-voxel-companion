+	if _ext_t > 0.0:
+		_ext_t -= delta
+		for k in _ext:
+			if _ch.has(k): _ch[k] = clampf(float(_ext[k]), 0.0, 1.0)
+		if float(_ext.get("jawOpen", 0.0)) > 0.05: _ch["mouthSmile"] = smile * 0.5
 	if mesh == null: return

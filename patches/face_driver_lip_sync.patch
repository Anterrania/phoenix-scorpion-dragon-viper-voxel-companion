+	return _talk_left > 0.0 or _ext_t > 0.0
+
+## Lip sync hookup (scripts/audio/lip_sync.gd): LipSync.apply_to(face) calls this every frame.
+## While fresh (0.2 s) these channels replace the built-in talk cycle; blink/smile/brow stay ours.
+func drive(ch: Dictionary) -> void:
+	_ext = ch; _ext_t = 0.2
+	_talk_left = 0.0   # the TTS-synced timeline wins over the length estimate
 

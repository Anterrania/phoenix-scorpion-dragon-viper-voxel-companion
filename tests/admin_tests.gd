extends RefCounted
## Viper OS admin tests: revisions (r#, log, diff, revert), tickets (workflow, comments, seed), wiki
## (links, revisions), brain-cell bridge, repo timeline, signup validation, headless admin scene load.
## Everything runs in a throwaway user://test_viper_<usec> root.

static func _rm_tree(p: String) -> void:
	if not DirAccess.dir_exists_absolute(p): return
	for d in DirAccess.get_directories_at(p): _rm_tree(p.path_join(d))
	for f in DirAccess.get_files_at(p): DirAccess.remove_absolute(p.path_join(f))
	DirAccess.remove_absolute(p)

static func run(t: Node) -> void:
	var root := "user://test_viper_%d" % Time.get_ticks_usec()
	# --- revisions ---
	var rs := RevisionStore.new(root)
	t.check(rs.head() == 0, "rev: fresh store at r0")
	var r1 := rs.commit("wiki", "wiki/A", null, "one\ntwo", "create A")
	var r2 := rs.commit("wiki", "wiki/A", "one\ntwo", "one\nTWO\nthree", "edit A")
	t.check(r1 == 1 and r2 == 2, "rev: monotonic r1, r2")
	t.check(rs.commit("bogus", "x", null, 1) == 0, "rev: unknown kind rejected")
	t.check(rs.commit("wiki", "wiki/Big", null, "x".repeat(40000)) == 0, "rev: oversized snapshot rejected")
	t.check(RevisionStore.new(root).head() == 2, "rev: head persists across reload")
	var d := rs.diff(2)
	t.check(d.contains("- two") and d.contains("+ TWO") and d.contains("+ three") and d.contains("  one"), "rev: line diff")
	t.check(rs.content_at("wiki/A", 1) == "one\ntwo" and rs.content_at("wiki/A", 0) == null, "rev: content_at")
	t.check(rs.history("wiki/A").size() == 2 and rs.history("wiki/A")[0]["rev"] == 2, "rev: history newest first")
	t.check(rs.revert(2) == 0, "rev: revert without applier refused")
	_rm_tree(root)

	# --- tickets ---
	root = "user://test_viper_%d" % Time.get_ticks_usec()
	rs = RevisionStore.new(root)
	var ts := TicketStore.new(rs, true)
	var seed_rows: Array = JSON.parse_string(FileAccess.get_file_as_string(TicketStore.SEED_PATH))
	t.check(ts.tickets.size() == seed_rows.size() and seed_rows.size() > 0, "ticket: seeded from TASK_TRACKER.csv export (%d)" % seed_rows.size())
	t.check(rs.head() == 1, "ticket: seed is one revision")
	t.check(ts.create({"summary": ""}) == 0, "ticket: empty summary rejected")
	var id := ts.create({"summary": "Ring gauge glitter", "priority": "P1", "milestone": "M-admin", "type": "enhancement"}, "phoenix")
	t.check(id == seed_rows.size() + 1 and ts.get_ticket(id)["status"] == "new", "ticket: create -> new")
	t.check(ts.transition(id, "reopened") == 0, "ticket: new -> reopened not allowed")
	var ra := ts.transition(id, "assigned", "phoenix", "fixed", "foxy_ani")
	t.check(ra > 0 and ts.get_ticket(id)["owner"] == "foxy_ani", "ticket: assigned with owner")
	t.check(ts.transition(id, "accepted", "foxy_ani") > 0 and ts.get_ticket(id)["owner"] == "foxy_ani", "ticket: accepted")
	t.check(ts.transition(id, "closed", "foxy_ani", "nonsense") == 0, "ticket: bad resolution refused")
	var rc := ts.transition(id, "closed", "foxy_ani", "fixed")
	t.check(rc > 0 and ts.get_ticket(id)["resolution"] == "fixed", "ticket: closed fixed")
	t.check(ts.transition(id, "reopened") > 0 and ts.get_ticket(id)["resolution"] == "", "ticket: reopened clears resolution")
	t.check(ts.comment(id, "Fixed in r%d, see #1 and WikiStart" % ra, "phoenix") > 0, "ticket: comment")
	t.check(ra in ts.get_ticket(id)["revisions"], "ticket: comment links r# into revisions")
	t.check(TicketStore.new(rs, true).get_ticket(id)["status"] == "reopened", "ticket: persisted, no reseed")
	t.check(ts.counts_by_status()["reopened"] >= 1, "ticket: counts_by_status")
	t.check(ts.update(id, {"priority": "P9"}) == 0 and ts.get_ticket(id)["priority"] == "P1", "ticket: invalid priority rolled back")
	# revert the close -> ticket goes back to accepted state
	var rv := rs.revert(rc, "phoenix")
	t.check(rv > 0 and ts.get_ticket(id)["status"] == "accepted", "ticket: revert(close rev) restores 'accepted' snapshot")
	t.check(rs.get_rev(rv)["message"].begins_with("Revert r%d" % rc), "ticket: revert recorded as new revision")

	# --- wiki ---
	var ws := WikiStore.new(rs, true)
	t.check(ws.pages.has("WikiStart") and ws.pages.has("VoxelArchitecture") and ws.pages.has("BrainFiles"), "wiki: seeded from docs/")
	t.check(not WikiStore.valid_name("../etc") and not WikiStore.valid_name("lower") and WikiStore.valid_name("ViperOs"), "wiki: page name validation")
	var w1 := ws.save_page("AdminNotes", "= Admin =\nSee VoxelArchitecture, #%d and r%d.\n[wiki:BrainFiles brain docs] [changeset:abcdef1]" % [id, ra], "phoenix")
	t.check(w1 > 0 and ws.save_page("AdminNotes", ws.get_text("AdminNotes")) == 0, "wiki: save + unchanged no-op")
	var html := ws.render(ws.get_text("AdminNotes"))
	t.check(html.contains("[url=wiki:VoxelArchitecture]"), "wiki: CamelCase WikiLink")
	t.check(html.contains("[url=ticket:%d]#%d[/url]" % [id, id]), "wiki: TicketLink #n")
	t.check(html.contains("[url=rev:%d]r%d[/url]" % [ra, ra]), "wiki: rev link rN")
	t.check(html.contains("[url=wiki:BrainFiles]") and html.contains("[url=changeset:abcdef1]"), "wiki: [wiki:] and [changeset:] links")
	t.check(not ws.render("NotAPageName here").contains("[url="), "wiki: unknown CamelCase not linked")
	t.check(ws.render("[color=red]x").contains("[lb]color"), "wiki: BBCode escaped")
	var w2 := ws.save_page("AdminNotes", "v2", "phoenix")
	t.check(ws.page_history("AdminNotes").size() == 2, "wiki: page history")
	t.check(rs.revert(w2) > 0 and ws.get_text("AdminNotes").begins_with("= Admin ="), "wiki: revert edit")
	t.check(WikiStore.parse_link("ticket:12") == {"type": "ticket", "id": "12"}, "wiki: parse_link")
	_rm_tree(root)

	# --- shared data + brain bridge ---
	root = "user://test_viper_%d" % Time.get_ticks_usec()
	var brain_root := "user://test_viper_brains_%d" % Time.get_ticks_usec()
	ViperAdminData.root = root
	ViperAdminData.reset()
	var head0 := ViperAdminData.revisions().head()
	var persona: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://companions/foxy_ani/persona.json"))
	var b := BrainCore.new("foxy_ani", persona, brain_root)
	var cell := BrainCell.make("viper_hi", "foxy_ani", {"type": "chat_keyword", "any": ["viper"]}, {"type": "say", "text": "Viper OS online."}, 0.5, "user")
	var res: Dictionary = b.propose(cell, "test")
	if res.get("status", "") == "pending": b.approve("viper_hi")
	var brain_revs := ViperAdminData.revisions().history("brain/foxy_ani/viper_hi", "brain_cell")
	t.check(brain_revs.size() == 1 and ViperAdminData.revisions().head() == head0 + 1, "bridge: brain cell commit -> global r#")
	b.rollback("viper_hi")
	t.check(ViperAdminData.revisions().history("brain/foxy_ani/viper_hi").size() == 2, "bridge: brain rollback also versioned")
	t.check(ViperAdminData.record_world_edit("dug 12 voxels", "r0_0") > 0, "bridge: world edit summary revision")
	ViperAdminData.reset()
	t.check(not BrainCore.on_commit.is_valid(), "bridge: reset unhooks BrainCore")
	_rm_tree(brain_root)

	# --- repo timeline ---
	var commits := RepoTimeline.commits()
	t.check(commits.size() > 0 and commits[0].has("sha") and commits[0].has("subject"), "repo: git log exported (%d commits)" % commits.size())
	t.check(not RepoTimeline.find(str(commits[0]["sha"])).is_empty(), "repo: find by sha")
	var merged := RepoTimeline.merged(ViperAdminData.revisions(), 500)
	t.check(merged.any(func(e): return e["kind"] == "commit") and merged.any(func(e): return e["kind"] == "revision"), "repo: merged timeline has commits + revisions")
	t.check(ViperKit.ring(0.4, "x") is Control, "kit: ring control (RingStat or RingGauge fallback)")
	t.check(ViperKit.theme() is Theme, "kit: theme")

static func run_scene(t: Node) -> void:
	ViperAdminData.root = "user://test_viper_scene_%d" % Time.get_ticks_usec()
	ViperAdminData.reset()
	# --- kit components (UI_DESIGN_LANGUAGE §8) ---
	var sp := SwipePages.new(); t.get_tree().root.add_child(sp)
	for i in 6: sp.add_page("P%d" % i, Control.new())
	t.check(sp.count() == SwipePages.MAX_TABS, "kit: tabs capped at 5")
	t.check(sp.release(-300, 0, 0.5) == 1, "kit: swipe >=30% width -> next page")
	t.check(sp.release(-60, 0, 0.05) == 2, "kit: fast flick (>600 px/s) -> next page")
	t.check(sp.release(-60, 0, 0.5) == 2, "kit: slow short drag stays")
	t.check(sp.release(250, 0, 0.5) == 1, "kit: swipe right -> previous")
	t.check(sp.release(-300, 400, 0.5) == 1, "kit: vertical drag ignored")
	sp.queue_free()
	var pl := PagedList.new(); t.get_tree().root.add_child(pl)
	pl.set_items(range(17), func(i): var l := Label.new(); l.text = str(i); return l)
	t.check(pl.row_count() == 7 and pl.pages() == 3, "kit: paged list 7 rows, 3 pages")
	pl.go(2); t.check(pl.row_count() == 3, "kit: last page remainder")
	pl.queue_free()
	var pr := PillRow.new().setup("#1 Test", "new", [["accepted", "Accept"]]); t.get_tree().root.add_child(pr)
	var tapped := [false]
	pr.tapped.connect(func(): tapped[0] = true)
	pr.swipe(-120); t.check(pr.actions_visible(), "kit: pill row swipe-left reveals actions")
	pr.swipe(120); t.check(not pr.actions_visible(), "kit: swipe-right hides actions")
	pr.swipe(2); t.check(tapped[0], "kit: small move = tap")
	pr.queue_free()
	var seg := SegmentedPills.new().setup([["a", "A"], ["b", "B"]]); t.get_tree().root.add_child(seg)
	var got := [""]
	seg.changed.connect(func(id): got[0] = id)
	seg.select("b"); t.check(seg.selected == "b" and got[0] == "b" and (seg.get_child(1) as Button).button_pressed, "kit: segmented pills")
	seg.queue_free()
	var host := Control.new(); t.get_tree().root.add_child(host)
	Toast.show_toast(host, "one two three four five six seven eight", "ok")
	var t2 := Toast.show_toast(host, "second", "bogus")
	await t.get_tree().process_frame
	t.check(t.get_tree().get_nodes_in_group(Toast.GROUP).size() == 1, "kit: one toast at a time")
	t.check(t2.variant == "ok", "kit: unknown toast variant -> ok")
	var t3 := Toast.show_toast(host, "one two three four five six seven eight")
	t.check(t3.text.split(" ").size() == 6, "kit: toast <= 6 words")
	host.queue_free()
	var hb := HoldButton.new(); var conf := [0]
	hb.confirmed.connect(func(): conf[0] += 1); t.get_tree().root.add_child(hb)
	hb.button_down.emit(); hb._process(0.3); t.check(conf[0] == 0, "kit: hold < 0.6 s does not confirm")
	hb._process(0.35); t.check(conf[0] == 1, "kit: hold 0.6 s confirms")
	hb.queue_free()
	var st := SignupStepper.new(); t.get_tree().root.add_child(st)
	await t.get_tree().process_frame
	var done := [{}]
	st.completed.connect(func(d): done[0] = d)
	t.check(st.ring.display_text == "1/5" and st.STEPS[st.step] == "name", "signup: starts at name, ring 1/5")
	st.next(); t.check(st.step == 0, "signup: empty name blocked")
	st._inputs["name"].text = "Phoenix"; st._inputs["handle"].text = "@phoenix_v"
	st.next(); t.check(st.step == 1 and st.data["handle"] == "phoenix_v", "signup: name -> avatar")
	st.next(); st.next()
	t.check(st.step == 3 and st.ring.display_text == "4/5", "signup: voice -> realm")
	st.prev(); t.check(st.step == 2, "signup: back")
	st.next(); st.next()
	t.check(st.STEPS[st.step] == "done" and done[0].get("name") == "Phoenix", "signup: completes with data")
	t.check(SignupStepper.validate("realm", {"realm": "../etc"}) != "", "signup: unknown realm rejected")
	st.queue_free()

	# --- admin screen ---
	var scn: PackedScene = load("res://scenes/admin/admin_screen.tscn")
	t.check(scn != null, "admin: scene loads")
	var a: AdminScreen = scn.instantiate()
	a.write_profile = false
	t.get_tree().root.add_child(a)
	await t.get_tree().process_frame
	t.check(a.theme == load("res://themes/phoenix_glass.tres"), "admin: uses phoenix_glass theme")
	t.check(a.pages.count() == AdminScreen.TABS.size() and AdminScreen.TABS.size() <= 5, "admin: 5 tabs")
	t.check(a.ticket_list.row_count() == mini(7, a.filtered_tickets().size()) and a.ticket_list.row_count() > 0, "admin: ticket pill rows (<=7)")
	t.check(a.ticket_list.row(0) is PillRow, "admin: ticket rows are PillRow")
	t.check(a.home.get_child_count() == 5 and a.home.get_child(0) is GlassCard, "admin: home cards")
	t.check(a.wiki_list.pages() > 1, "admin: wiki pages paged")
	t.check(a.timeline.days.size() > 0 and a.timeline.day_events().size() > 0, "admin: ring timeline day view")
	t.check(a.report_text().contains("Milestones"), "admin: report")
	var nid := ViperAdminData.tickets().create({"summary": "Admin swipe test"}, "phoenix")
	a.ticket_filter.select("new"); a._refresh_tickets()
	t.check(a.do_transition(nid, "accepted") > 0 and ViperAdminData.tickets().get_ticket(nid)["status"] == "accepted", "admin: swipe action transitions ticket")
	a._on_link("ticket:%d" % nid)
	t.check(a.current_ticket == nid and a.pages.current() == 1 and a.ticket_detail.visible, "admin: ticket link opens detail")
	a._on_link("wiki:BrainFiles")
	t.check(a.current_page == "BrainFiles" and a.wiki_detail.visible and a.wiki_view.text.contains("BrainFiles"), "admin: wiki link opens page")
	a.wiki_edit.visible = true; a.wiki_edit.text = "= Brain =\nEdited in admin."
	var wr := a.save_wiki_edit()
	t.check(wr > 0, "admin: wiki edit saved as revision")
	a.show_revision(wr)
	t.check(a.timeline.expanded() == "r%d" % wr and a.revert_btn.visible, "admin: revision expands + revert offered")
	a.revert_btn.simulate_hold()
	t.check(not ViperAdminData.wiki().get_text("BrainFiles").begins_with("= Brain ="), "admin: hold-to-revert restored page")
	t.check(a.stepper != null, "admin: profile shows stepper when no signup")
	t.check(a.save_signup({"name": "P", "handle": "ok_handle", "voice": "warm", "realm": "cosmic"}) != "", "signup: short name rejected")
	t.check(a.save_signup({"name": "Phoenix", "handle": "bad handle!", "voice": "warm", "realm": "cosmic"}) != "", "signup: bad handle rejected")
	t.check(a.save_signup({"name": "someone@example.com", "handle": "phoenix_v", "voice": "warm", "realm": "cosmic"}) != "", "signup: email as name rejected")
	t.check(a.save_signup({"name": "Phoenix", "handle": "@phoenix_v", "avatar": "starlight", "voice": "deep", "realm": "cosmic"}) == "" and AdminScreen.load_signup()["handle"] == "phoenix_v", "signup: saved locally")
	a._refresh_profile()
	t.check(a.stepper == null and a.profile_box.get_child_count() >= 3, "admin: profile card after signup")
	a.queue_free()
	await t.get_tree().process_frame
	_rm_tree(ViperAdminData.root)
	ViperAdminData.root = "user://viper"
	ViperAdminData.reset()
